<!DOCTYPE html>
<html lang="<%= openmrsDefaultLocale %>" data-default-lang="<%= openmrsDefaultLocale %>">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title><%= openmrsPageTitle %></title>
    <link
      rel="shortcut icon"
      type="image/x-icon"
      href="<%= openmrsFavicon %>"
    >
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="importmap-type" content="systemjs-importmap">
    <link rel="stylesheet" href="<%= openmrsPublicPath %>/<%= openmrsCssFilename %>">
<% if (openmrsExtraAssets && openmrsExtraAssets.length) { %>
<% openmrsExtraAssets.forEach(function(asset) { %>
<% if (asset.endsWith('.css')) { %>
    <link rel="stylesheet" href="<%= openmrsPublicPath %>/<%= asset %>">
<% } %>
<% }); %>
<% } %>
<% if (openmrsImportmapDef) { %>
    <script type="systemjs-importmap"><%= openmrsImportmapDef %></script>
<% } else if (openmrsImportmapUrl) { %>
    <link
      rel="preload"
      href="<%= openmrsImportmapUrl %>"
      as="fetch"
      crossorigin="anonymous"
    >
    <script type="systemjs-importmap" src="<%= openmrsImportmapUrl %>"></script>
<% } %>
<% if (openmrsCoreImportmap) { %>
  <script type="systemjs-importmap"><%= openmrsCoreImportmap %></script>
<% } %>
<% if (openmrsRoutesDef) { %>
  <script type="openmrs-routes"><%= openmrsRoutesDef %></script>
<% } else if (openmrsRoutesUrl) { %>
  <link
    rel="preload"
    href="<%= openmrsRoutesUrl %>"
    as="fetch"
    crossorigin="anonymous"
  >
  <script type="openmrs-routes" src="<%= openmrsRoutesUrl %>"></script>
<% } %>
<% if (openmrsCoreRoutes) { %>
  <script type="openmrs-routes"><%= openmrsCoreRoutes %></script>
<% } %>
    <%= htmlWebpackPlugin.tags.headTags %>
  </head>
  <body>
    <%= htmlWebpackPlugin.tags.bodyTags %>
<% if (openmrsExtraAssets && openmrsExtraAssets.length) { %>
<% openmrsExtraAssets.forEach(function(asset) { %>
<% if (asset.endsWith('.js')) { %>
    <script src="<%= openmrsPublicPath %>/<%= asset %>"></script>
<% } %>
<% }); %>
<% } %>
    <div class="omrs-toasts-container"></div>
    <div class="omrs-inline-notifications-container"></div>
    <div class="omrs-actionable-notifications-container"></div>
    <div class="omrs-snackbars-container"></div>
    <div class="omrs-modals-container"></div>
    <div id="omrs-left-nav-container"></div>
    <div id="omrs-workspaces-container"></div>
    <div id="omrs-top-nav-app-container"></div>
    <div id="omrs-apps-container"></div>
    <template id="loading-spinner">
      <div class="omrs-loading-spinner">
        <div class="cds--loading cds--loading--small" role="status" aria-live="assertive">
          <svg class="cds--loading__svg" viewBox="0 0 100 100">
            <title>Loading</title>
            <circle class="cds--loading__background" cx="50%" cy="50%" r="42"></circle>
            <circle class="cds--loading__stroke" cx="50%" cy="50%" r="42"></circle>
          </svg>
        </div>
      </div>
    </template>
    <template id="app-error">
      <div class="omrs-app-error">
        <div class="omrs-app-error__card">
          <h1 data-i18n="applicationError">Application Error</h1>
          <p data-i18n="somethingWentWrongTryReloading">Something went wrong. Please try reloading.</p>
          <p data-i18n="contactAdministratorIfIssuePersists">Contact your system administrator if the problem persists.</p>
          <div id="buttons">
            <button class="cds--btn cds--btn--primary" onclick="location.reload()" data-i18n="reload">Reload</button>
          </div>
          <div class="cds--snippet cds--snippet--multi cds--snippet--wraptext">
            <div tabindex="0" class="cds--snippet-container" role="textbox" aria-readonly="true" aria-multiline="true" aria-label="Code Snippet Text" style="max-height: 240px; min-height: 48px">
              <pre><code data-var="message"></code></pre>
            </div>
            <div class="cds--layout-constraint--size__default-md cds--layout-constraint--size__max-lg">
              <span class="cds--popover-container cds--popover--caret cds--popover--high-contrast cds--popover--bottom cds--tooltip cds--icon-tooltip">
                <button data-copy-btn class="cds--copy-btn cds--btn cds--btn--sm cds--layout--size-sm cds--btn--primary cds--btn--icon-only" type="button">
                  <span class="cds--visually-hidden" data-i18n="copyToClipboard">Copy to clipboard</span>
                  <svg focusable="false" preserveAspectRatio="xMidYMid meet" fill="currentColor" width="16" height="16" viewBox="0 0 32 32" aria-hidden="true" class="cds--snippet__icon" xmlns="http://www.w3.org/2000/svg"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"></path><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"></path></svg>
                </button>
                <span class="cds--popover" aria-hidden="true">
                  <span class="cds--popover-content cds--tooltip-content" data-i18n="copied">Copied!</span>
                  <span class="cds--popover-caret"></span>
                </span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </template>
    <script>
      initializeSpa({
        apiUrl: "<%= openmrsApiUrl %>",
        spaPath: "<%= openmrsPublicPath %>",
        env: "<%= openmrsEnvironment %>",
        configUrls: [<%= openmrsConfigUrls %>],
      });
    </script>
  </body>
</html>
