{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "CommonJS",
    "target": "es2022",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "moduleResolution": "node",
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "lib": ["es2022"]
  },
  "include": ["src/**/*"]
}
