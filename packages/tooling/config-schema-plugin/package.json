{
  "name": "@openmrs/config-schema-plugin",
  "version": "10.0.0",
  "license": "MPL-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">= 20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:development": "tsc",
    "clean": "git clean -fdX -- dist",
    "lint": "eslint src",
    "test": "cross-env TZ=UTC vitest run",
    "test:watch": "cross-env TZ=UTC vitest watch --passWithNoTests",
    "coverage": "cross-env TZ=UTC vitest run --coverage",
    "typescript": "tsc --noEmit --project tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmrs/openmrs-esm-core.git"
  },
  "bugs": {
    "url": "https://github.com/openmrs/openmrs-esm-core/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "openmrs",
    "microfrontends",
    "webpack",
    "rspack",
    "config"
  ],
  "homepage": "https://github.com/openmrs/openmrs-esm-core#readme",
  "dependencies": {
    "@openmrs/esm-config": "workspace:*",
    "@swc/core": "1.15.21",
    "happy-dom": "^20.6.0",
    "magic-string": "^0.30.17"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  }
}
